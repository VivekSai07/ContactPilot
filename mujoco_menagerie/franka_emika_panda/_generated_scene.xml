<mujoco model="panda_tabletop_grasping">
  <include file="_panda_sim_patched.xml"/>

  <statistic center="0.55 0 0.9" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="1280" offheight="960" azimuth="120" elevation="-20"/>
    <map znear="0.005"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.5 0.6" rgb2="0.1 0.1 0.15" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <texture type="2d" name="tabletex" builtin="flat" rgb1="0.82 0.71 0.55" width="32" height="32"/>
    <material name="table_mat" texture="tabletex" reflectance="0.05"/>
    
  </asset>

  <worldbody>
    <light pos="0.6 0 2.2" dir="0 0 -1" directional="true" diffuse="0.7 0.7 0.7"/>
    <light pos="1.4 0.8 1.8" dir="-0.4 -0.4 -1" diffuse="0.35 0.35 0.35"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Robot pedestal: lifts link0 (robot base frame) to tabletop height.
         T_world_base = Trans(0, 0, 0.75) -->
    <geom name="pedestal" type="cylinder" size="0.10 0.3750"
          pos="0 0 0.3750" rgba="0.3 0.3 0.32 1"/>

    <!-- Table: top surface is the z = 0.75 plane -->
    <geom name="table_top" type="box"
          size="0.4 0.45 0.0200"
          pos="0.6 0 0.7300" material="table_mat"
          friction="0.9 0.005 0.0001"/>
    <geom type="cylinder" size="0.025 0.3550" pos="0.250 0.400 0.3550" rgba="0.45 0.33 0.22 1" contype="0" conaffinity="0"/>
    <geom type="cylinder" size="0.025 0.3550" pos="0.250 -0.400 0.3550" rgba="0.45 0.33 0.22 1" contype="0" conaffinity="0"/>
    <geom type="cylinder" size="0.025 0.3550" pos="0.950 0.400 0.3550" rgba="0.45 0.33 0.22 1" contype="0" conaffinity="0"/>
    <geom type="cylinder" size="0.025 0.3550" pos="0.950 -0.400 0.3550" rgba="0.45 0.33 0.22 1" contype="0" conaffinity="0"/>

    <!-- Place bin (open-top tray, pick-and-place target) -->
    <geom name="bin_floor" type="box" size="0.1320 0.1320 0.004" pos="0.45 -0.3 0.7540" rgba="0.50 0.55 0.62 1"/>
    <geom name="bin_wall_xp" type="box" size="0.0060 0.1320 0.0250" pos="0.5760 -0.3 0.7830" rgba="0.50 0.55 0.62 1"/>
    <geom name="bin_wall_xm" type="box" size="0.0060 0.1320 0.0250" pos="0.3240 -0.3 0.7830" rgba="0.50 0.55 0.62 1"/>
    <geom name="bin_wall_yp" type="box" size="0.1320 0.0060 0.0250" pos="0.45 -0.1740 0.7830" rgba="0.50 0.55 0.62 1"/>
    <geom name="bin_wall_ym" type="box" size="0.1320 0.0060 0.0250" pos="0.45 -0.4260 0.7830" rgba="0.50 0.55 0.62 1"/>

    <!-- Eye-to-hand RGB-D camera, fixed in the WORLD frame (like a tripod-
         mounted RealSense D455 across the table). MuJoCo convention here;
         conversion to OpenCV happens in CameraModule. -->
    <camera name="ext_cam" pos="1.350000 0.000000 1.400000"
            xyaxes="0.000000 1.000000 -0.000000 -0.630593 0.000000 0.776114" fovy="58.0"/>

    <!-- Close-up side camera: only used to record execution GIFs -->
    <camera name="record_cam"
            pos="0.620000 -0.920000 1.180000"
            xyaxes="0.990621 0.136637 -0.000000 -0.054260 0.393382 0.917773" fovy="52.0"/>
    <!-- Second observation camera (P2 fusion) -->
    <camera name="side_cam" pos="0.024966 0.283392 1.397074" xyaxes="-0.024734 -0.999604 -0.013417 0.777362 -0.027670 0.628445" fovy="58.0"/>

    <body name="obj_0" pos="0 0 0" quat="0.96793 0 0 0.25123"><freejoint name="obj_0_joint"/><geom type="box" size="0.0217 0.0180 0.0481" rgba="0.904 0.559 0.931 1"/></body>
    <body name="obj_1" pos="0 0 0" quat="-0.95318 0 0 0.30239"><freejoint name="obj_1_joint"/><geom type="box" size="0.0196 0.0189 0.0476" rgba="0.290 0.847 0.585 1"/></body>
    <body name="obj_2" pos="0 0 0" quat="-0.97524 0 0 0.22113"><freejoint name="obj_2_joint"/><geom type="box" size="0.0148 0.0217 0.0447" rgba="0.937 0.446 0.925 1"/></body>
  </worldbody>
</mujoco>
